<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Refund_Amount_Positive</fullName>
    <active>true</active>
    <description>VR_Refund_Amount_Positive</description>
    <errorConditionFormula>Refund_Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Refund_Amount__c</errorDisplayField>
    <errorMessage>Refund amount must be strictly greater than zero.</errorMessage>
</ValidationRule>
