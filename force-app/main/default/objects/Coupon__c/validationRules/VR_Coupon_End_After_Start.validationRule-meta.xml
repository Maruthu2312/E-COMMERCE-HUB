<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Coupon_End_After_Start</fullName>
    <active>true</active>
    <description>VR_Coupon_End_After_Start</description>
    <errorConditionFormula>NOT(ISBLANK(Start_Date__c)) &amp;&amp; NOT(ISBLANK(End_Date__c)) &amp;&amp; End_Date__c &lt; Start_Date__c</errorConditionFormula>
    <errorDisplayField>End_Date__c</errorDisplayField>
    <errorMessage>Coupon validity end date cannot be prior to start date.</errorMessage>
</ValidationRule>
