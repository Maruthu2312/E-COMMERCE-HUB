<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Coupon_Discount_Non_Negative</fullName>
    <active>true</active>
    <description>VR_Coupon_Discount_Non_Negative</description>
    <errorConditionFormula>Discount_Value__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Discount_Value__c</errorDisplayField>
    <errorMessage>Coupon discount value must be greater than zero.</errorMessage>
</ValidationRule>
