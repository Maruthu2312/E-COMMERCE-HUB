<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Rating_Between_1_And_5</fullName>
    <active>true</active>
    <description>VR_Rating_Between_1_And_5</description>
    <errorConditionFormula>Rating__c &lt; 1 || Rating__c &gt; 5</errorConditionFormula>
    <errorDisplayField>Rating__c</errorDisplayField>
    <errorMessage>Review rating must be an integer between 1 and 5 stars.</errorMessage>
</ValidationRule>
