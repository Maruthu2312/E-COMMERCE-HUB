<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Paid_Requires_Valid_Amount</fullName>
    <active>true</active>
    <description>VR_Paid_Requires_Valid_Amount</description>
    <errorConditionFormula>ISPICKVAL(Payment_Status__c, "Successful") &amp;&amp; (ISBLANK(Amount__c) || Amount__c &lt;= 0)</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Payment cannot be marked as Successful with a zero or negative amount.</errorMessage>
</ValidationRule>
