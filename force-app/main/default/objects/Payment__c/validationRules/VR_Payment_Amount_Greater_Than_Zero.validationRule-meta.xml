<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Payment_Amount_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>VR_Payment_Amount_Greater_Than_Zero</description>
    <errorConditionFormula>Amount__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Amount__c</errorDisplayField>
    <errorMessage>Payment amount must be greater than zero.</errorMessage>
</ValidationRule>
