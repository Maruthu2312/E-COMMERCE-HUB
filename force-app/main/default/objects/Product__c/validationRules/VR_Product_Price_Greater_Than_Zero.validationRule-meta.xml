<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Product_Price_Greater_Than_Zero</fullName>
    <active>true</active>
    <description>VR_Product_Price_Greater_Than_Zero</description>
    <errorConditionFormula>Price__c &lt;= 0</errorConditionFormula>
    <errorDisplayField>Price__c</errorDisplayField>
    <errorMessage>Product price must be strictly greater than zero.</errorMessage>
</ValidationRule>
